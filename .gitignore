# ── Python / Backend ───────────────────────────────────────────────────────
backend/__pycache__/
backend/**/__pycache__/
backend/.pytest_cache/
backend/*.egg-info/
backend/.venv/
backend/venv/
*.pyc

# Runtime data (DB, uploaded images, FAISS indexes)
backend/data/db/*.db
backend/data/db/*.db-*
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/faiss_index/*
!backend/data/faiss_index/.gitkeep

# ── Node / Frontend ────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/.env.local

# ── Env files ──────────────────────────────────────────────────────────────
.env
backend/.env
frontend/.env.local

