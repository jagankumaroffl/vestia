# ── App ────────────────────────────────────────────────────────────────────
APP_NAME=Vestia
APP_VERSION=1.0.0
DEBUG=false

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (default, dev):
DATABASE_URL=sqlite:///./data/db/vestia.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://vestia:password@localhost:5432/vestia

# ── Storage ────────────────────────────────────────────────────────────────
UPLOAD_DIR=data/uploads
FAISS_INDEX_DIR=data/faiss_index

# ── CORS ───────────────────────────────────────────────────────────────────
# JSON array of allowed origins for the frontend
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Computer Vision ────────────────────────────────────────────────────────
FASHION_CLIP_MODEL=patrickjohncyh/fashion-clip
EMBEDDING_DIMENSION=512

# ── Upload limits ──────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10

# ── Single-user mode ───────────────────────────────────────────────────────
DEFAULT_USER_ID=1
